{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "enabledManagers": [
    "github-actions",
    "cargo"
  ],
  "automerge": false,
  "platformAutomerge": false,
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "minor": {
    "automerge": true
  }
}
